# Mẫu cấu hình SafeWatch. Cách dùng:
#   1. Chép file này thành .streamlit/secrets.toml (file đó đã nằm trong .gitignore, KHÔNG commit).
#   2. Điền khoá của kênh muốn dùng. Kênh nào để trống thì app tự tắt kênh đó.
#   3. Khởi động lại app.
# Không bắt buộc kênh nào: thiếu hết thì app vẫn chạy, chỉ không gửi cảnh báo ra ngoài.

# ---- Bảo mật (BẮT BUỘC đặt trước khi mở app cho người khác)
# Khoá mã hoá dữ liệu nhạy cảm (SĐT, email, Chat ID, hồ sơ sức khoẻ). Tạo bằng:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Để trống: app tự tạo file data/.data_key. MẤT KHOÁ = MẤT DỮ LIỆU ĐÃ MÃ HOÁ -> sao lưu khoá ở nơi an toàn.
DATA_KEY = ""

# Địa chỉ web của app, dùng cho link "Tôi đã nhận" trong email / SMS.
# Chạy trên máy: http://localhost:8501 (link chỉ mở được trên chính máy đó).
PUBLIC_BASE_URL = ""

# ---- Telegram (khuyến nghị: miễn phí, có nút "Đã nhận" ngay trong tin nhắn)
# Tạo bot qua @BotFather, dán token vào đây. Người nhận nhắn /start cho bot để lấy Chat ID.
TELEGRAM_BOT_TOKEN = ""

# ---- Email (SMTP). Gmail: smtp.gmail.com, cổng 465, mật khẩu ứng dụng (App Password)
SMTP_HOST = ""
SMTP_PORT = "465"
SMTP_USER = ""
SMTP_PASSWORD = ""
SMTP_FROM = ""

# ---- SMS Brandname qua eSMS (cần brandname + mẫu tin đã được duyệt)
ESMS_API_KEY = ""
ESMS_SECRET_KEY = ""
ESMS_BRANDNAME = ""
ESMS_TEMPLATE = ""      # mẫu tin đã đăng ký; chỗ trống: {kind} {details} {time} {link} {code}
ESMS_SANDBOX = "1"      # "1" = gọi API nhưng không gửi, không trừ tiền; "0" = gửi thật

# ---- SMS qua điện thoại Android có SIM (app "SMS Gateway for Android")
SMS_GATEWAY_URL = "https://api.sms-gate.app/3rdparty/v1"   # cùng Wi-Fi: http://<IP điện thoại>:8080
SMS_GATEWAY_USER = ""
SMS_GATEWAY_PASSWORD = ""

# ---- SMS qua Twilio
TWILIO_ACCOUNT_SID = ""
TWILIO_AUTH_TOKEN = ""
TWILIO_FROM = ""

# ---- Máy chuyển tiếp hình (TURN) cho webcam khi app chạy trên mạng (Streamlit Cloud...).
# Chạy trên máy (localhost) thì không cần.
CF_TURN_KEY_ID = ""
CF_TURN_API_TOKEN = ""
HF_TOKEN = ""
